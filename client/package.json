    "mongodb",
    "mongoose",
    "fullstack",
    "tailwind-css",
    "framer-motion",
    "state-management",
    "queue-management",
    "concurrent-processing",
    "sequence-diagram",
    "dashboard",
    "order-tracking"
  ],
