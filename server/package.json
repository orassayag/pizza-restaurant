{
  "name": "pizza-restaurant-server",
  "version": "1.0.0",
  "description": "A real-time restaurant simulator managing a multi-stage pizza workflow. This full-stack application orchestrates concurrent worker queues from dough prep to serving. It uses TypeScript, Node.js, and Socket.IO for live data streaming to an animated Next.js UI, all backed by a MongoDB database",
  "keywords": [
    "pizza-restaurant",
    "real-time",
    "worker-simulation",
    "socketio",
    "typescript",
    "nodejs",
    "express",
    "nextjs",
    "react",
    "mongodb",
    "mongoose",
    "fullstack",
    "tailwind-css",
    "framer-motion",
    "state-management",
    "queue-management",
    "concurrent-processing",
    "sequence-diagram",
    "dashboard",
    "order-tracking"
  ],
  "homepage": "https://github.com/orassayag/pizza-restaurant#readme",
  "bugs": {
    "url": "https://github.com/orassayag/pizza-restaurant/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/pizza-restaurant.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
  "author": {
    "name": "Or Assayag",
    "email": "orassayag@gmail.com",
    "url": "https://github.com/orassayag"
  },
  "contributors": [
    {
      "name": "Or Assayag",
      "email": "orassayag@gmail.com",
      "url": "https://github.com/orassayag"
    }
  ],
  "type": "commonjs",
  "main": "src/app.ts",
  "files": [
    ".vscode",
    "config",
    "logs",
    "src",
    ".eslintrc.json",
    ".gitignore",
    ".prettierrc",
    "knip.json",
    "package-lock.json",
    "package.json",
    "tsconfig.build.json",
    "tsconfig.json"
  ],
  "scripts": {
    "dev": "nodemon src/app.ts",
    "kill": "taskkill -f -im node.exe",
    "lint": "eslint src",
    "lint-staged": "lint-staged",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "start": "npm run dbm:up && tsc --project tsconfig.build.json && node dist/src/app.js"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npm run prettier:fix",
      "npm run lint",
      "git add"
    ]
  },
  "dependencies": {
    "chance": "^1.1.11",
    "debug": "^4.3.4",
    "express": "^4.18.2",
    "mongoose": "^7.2.2",
    "nodemon": "2.0.22",
    "socket.io": "^4.6.2",
    "ts-node": "10.9.1",
    "typescript": "5.1.3",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@types/chance": "^1.1.3",
    "@types/cors": "^2.8.13",
    "@types/debug": "^4.1.8",
    "@types/express": "^4.17.17",
    "@types/node": "^20.2.5",
    "@typescript-eslint/eslint-plugin": "5.59.8",
    "@typescript-eslint/parser": "5.59.8",
    "eslint": "8.42.0",
    "eslint-config-airbnb-typescript": "17.0.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-prettier": "4.2.1",
    "prettier": "2.8.8"
  }
}
